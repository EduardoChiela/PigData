# Copie para .env e preencha. Nunca commite o arquivo .env.

# Google Maps JavaScript API (usada no browser via Vite)
VITE_GOOGLE_MAPS_API_KEY=

# Pagamento do protótipo: sempre demo (não envia a gateway)
PAYMENT_MODE=demo

# Google Calendar OAuth (apenas backend / futuro — NÃO use VITE_)
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
